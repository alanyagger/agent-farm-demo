DATABASE_URL=sqlite:///./data/agent_farm.db
CREDENTIAL_PROVIDER=mock
SCHEDULER_INTERVAL_SECONDS=2
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Agent runtime. Keep "rules" for the offline deterministic demo. Change to
# "llm" after setting a DeepSeek key to enable real external tool calls.
AGENT_RUNTIME_MODE=rules
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=20
AGENT_MAX_TOOL_ROUNDS=4

# Real CMCC adapter (disabled by default)
CMCC_BASE_URL=
CMCC_APP_ID=
CMCC_APP_KEY=
CMCC_CLIENT_SECRET=
CMCC_AGENT_TEMPLATE_ID=
CMCC_DEMO_PHONE=
