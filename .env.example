DATABASE_URL=sqlite:///./data/agent_farm.db
CREDENTIAL_PROVIDER=mock
SCHEDULER_INTERVAL_SECONDS=2
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Agent runtime. Keep "rules" for the offline deterministic demo. Change to
# "llm" after setting a DeepSeek key to enable real external tool calls.
AGENT_RUNTIME_MODE=rules
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=20
AGENT_MAX_TOOL_ROUNDS=4

# Real CMCC adapter (disabled by default)
CMCC_BASE_URL=https://vctest.cmccsign.com
CMCC_APP_ID=
CMCC_APP_KEY=
CMCC_CLIENT_SECRET=
CMCC_AGENT_TEMPLATE_ID=341kv2bl96zpb925h1qqk2q687zz2zpv
CMCC_DEMO_PHONE=
CMCC_ADMISSION_MODE=off
CMCC_ADMISSION_AGENT_MAPPINGS=
CMCC_ADMISSION_TIMEOUT_SECONDS=3
CMCC_ADMISSION_CACHE_SECONDS=10

# OpenClaw is installed by scripts/setup-openclaw.ps1. Keep the token empty in
# source control; the setup script generates it in the local .env file.
OPENCLAW_FARM_ENABLED=false
OPENCLAW_FARM_TOKEN=
OPENCLAW_FARM_RUN_TTL_SECONDS=300
OPENCLAW_MODEL_LABEL=deepseek/deepseek-v4-pro
